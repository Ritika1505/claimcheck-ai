AZURE_OPENAI_ENDPOINT=https://<resource>.openai.azure.com/
AZURE_OPENAI_API_KEY=replace-with-your-key
AZURE_OPENAI_API_VERSION=2024-02-01
AZURE_OPENAI_CHAT_DEPLOYMENT=replace-with-your-chat-deployment
AZURE_OPENAI_EMBEDDING_DEPLOYMENT=text-embedding-3-small

AZURE_SEARCH_ENDPOINT=https://<service>.search.windows.net
AZURE_SEARCH_API_KEY=replace-with-your-key
AZURE_SEARCH_INDEX_NAME=replace-with-your-index-name

AZURE_VI_ACCOUNT_ID=replace-with-your-video-indexer-account-id
AZURE_VI_LOCATION=replace-with-your-video-indexer-location
AZURE_SUBSCRIPTION_ID=replace-with-your-subscription-id
AZURE_RESOURCE_GROUP=replace-with-your-resource-group
AZURE_VI_NAME=project-brand-guardian-001

# Optional. Leave unset to disable Azure Monitor telemetry.
# APPLICATIONINSIGHTS_CONNECTION_STRING=
